# Variabili della radice: le legge `docker compose` per i due file
# docker-compose.dev.yml e docker-compose.prod.yml.
#
# Copiare in .env e riempire SOLO cio' che serve:
#
#     cp .env.example .env
#
# Il file .env e' escluso da git. Questo no: qui non ci vanno valori, solo
# nomi e spiegazioni.
#
# ---------------------------------------------------------------------------
# PER AVVIARE IN LOCALE NON SERVE NIENTE DI QUESTO FILE.
#
#     docker compose -f docker-compose.dev.yml up -d --build
#
# basta e avanza: ogni variabile qui sotto ha un default che fa partire il
# sito con i dati di meta e tornei veri. Quello che resta spento senza chiavi
# e' l'assistente (/api/chat risponde 503) e la registrazione con captcha.
# Il resto del sito funziona.
# ---------------------------------------------------------------------------


# --- Database di partenza ---------------------------------------------------
# Da quale dump Postgres crea il database la PRIMA volta.
#
# Il default e' ./docker/ci-db.sql.gz, che sta nel repo: stesso schema e stessi
# dati di meta e tornei della produzione, senza la tabella degli utenti.
#
# Chi ha la replica di produzione (vedi "Getting the data" nel README) la usa
# cosi'. Quel file non e' in git perche' contiene email e hash delle password.
#SEED_SQL=./docker/initdb/10-beyblade.sql.gz
#
# Attenzione: Postgres esegue i seed solo su un volume vuoto. Dopo aver
# cambiato questa variabile serve `npm run db:reset`, che cancella il volume.


# --- Immagini dei componenti ------------------------------------------------
# Dove il browser scarica le foto di blade, ratchet e bit. Il default punta
# all'archivio pubblico di produzione, quindi un clone pulito vede il sito
# completo. Va cambiato solo da chi ha un proprio Garage/MinIO.
#
# E' un argomento di BUILD: finisce dentro il bundle JavaScript, quindi
# modificarlo richiede `up -d --build`, non un riavvio.
#VITE_PUBLIC_MINIO_URL=


# --- Sessioni ---------------------------------------------------------------
# Firma i cookie di sessione. In sviluppo c'e' un default esplicito e va bene.
# In produzione NON deve cambiare fra un rilascio e l'altro: un valore nuovo
# invalida i cookie gia' nei browser, cioe' disconnette tutti.
#SESSION_SECRET=


# --- Tornei: ChallengerMode -------------------------------------------------
# Senza CHALLENGERMODE_REFRESH_KEY i tornei si vedono lo stesso, ma i nomi
# degradano a "Tournament <uuid>": e' un fallimento parziale che sembra un
# problema dei dati invece che una variabile mancante.
#CHALLENGERMODE_REFRESH_KEY=
#CHALLENGERMODE_API_KEY=
#CHALLENGERMODE_AUTH_URL=
#CHALLENGERMODE_GRAPHQL_URL=
# Default 1440 minuti. Alzarlo molto in locale evita di interrogare l'API vera.
#CHALLENGERMODE_CACHE_TTL_MINUTES=


# --- L'assistente (RAG) -----------------------------------------------------
# Senza VOYAGE_API_KEY non c'e' recupero (embedding e re-rank passano di li'),
# senza la chiave del fornitore non c'e' generazione. In entrambi i casi
# /api/chat risponde 503 e il resto del sito continua a funzionare - che e' il
# motivo per cui si puo' distribuire prima di avere le chiavi.
#VOYAGE_API_KEY=
#OPENROUTER_API_KEY=
#ANTHROPIC_API_KEY=
# 'openrouter' oppure 'claude'. Il default del codice e' 'claude'; i due file
# compose dichiarano 'openrouter' per far comportare le macchine allo stesso
# modo anche quando la variabile non c'e'.
#CHAT_PROVIDER=
#CHAT_MODEL=
#OPENROUTER_MODEL=


# ===========================================================================
# SOLO PRODUZIONE (docker-compose.prod.yml)
#
# In sviluppo il database lo crea il compose; in produzione e' una risorsa
# esterna e questi valori diventano obbligatori.
# ===========================================================================

# Obbligatorie: senza, il compose di produzione non parte.
#DATABASE_URL=
#APP_BASE_URL=

# Vuoto nel rilascio a origine singola, dove nginx fa da proxy verso il backend.
#CORS_ORIGINS=
# Dove nginx manda /api, /sitemap.xml e /combo.
#API_UPSTREAM=

# --- Registrazione ----------------------------------------------------------
# La chiave del sito sta in frontend/.env (e' pubblica, finisce nel bundle);
# questa e' il segreto che verifica il token lato server.
#RECAPTCHA_SECRET_KEY=
# Invio dell'email di conferma.
#RESEND_API_KEY=

# --- Collegamento degli account ---------------------------------------------
# Credenziali OAuth, distinte dalla chiave di servizio piu' sopra.
#CM_CLIENT_ID=
#CM_CLIENT_SECRET=
#CM_USERINFO_URL=
#CHALLONGE_API_KEY=
#CHALLONGE_APP_CLIENT_ID=
#CHALLONGE_APP_CLIENT_SECRET=
