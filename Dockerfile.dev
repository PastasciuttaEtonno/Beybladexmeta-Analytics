## Development Dockerfile (hot reload, dev deps)

FROM node:20-alpine
WORKDIR /app

# Install git (optional) and any tools needed for dev
RUN apk add --no-cache git

# Copy manifests and install all dependencies (including dev)
COPY package.json package-lock.json ./
RUN npm ci

# Copy source (optional for initial build); in practice, mount with -v for live reload
COPY . .

# Dev environment vars
ENV NODE_ENV=development \
    PORT=5000 \
    CHOKIDAR_USEPOLLING=1 \
    WATCHPACK_POLLING=true

# Expose dev server port
EXPOSE 5000

# Default command runs the dev server (Express + Vite in middleware mode)
CMD ["npm", "run", "dev"]