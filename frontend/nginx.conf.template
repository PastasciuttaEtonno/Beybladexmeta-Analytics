    # END STRANGLER ROUTES

    # --- Everything the backend owns ---
    location /api/ {
        set $express_upstream "${BACKEND_UPSTREAM}";
        proxy_pass $express_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        # Tournament imports and OG rendering can take a while.
        proxy_read_timeout 120s;
    }

    location = /sitemap.xml {
        set $express_upstream "${BACKEND_UPSTREAM}";
        proxy_pass $express_upstream$request_uri;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # /combo/:id goes to the backend, which fetches /index.html back from here
    # and rewrites the og:image / twitter:image tags before returning it.
    # Serving /index.html is a plain static hit below, so there is no loop.
    location /combo/ {
        set $express_upstream "${BACKEND_UPSTREAM}";
        proxy_pass $express_upstream$request_uri;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # If the backend is down, still serve the SPA rather than a 502.
        proxy_intercept_errors on;
        error_page 500 502 503 504 = /index.html;
    }

    # --- Static assets: hashed filenames, so cache hard ---
    # `expires` is used instead of `add_header Cache-Control`: an add_header in a
    # location DISCARDS every header inherited from the server block, which would
    # silently drop the security headers above. `expires` has no such effect.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # The HTML shell must always be revalidated, or a deploy leaves clients on a
    # stale index.html pointing at asset hashes that no longer exist.
    location = /index.html {
        expires -1;
    }

    # --- SPA fallback ---
    location / {
        try_files $uri $uri/ /index.html;
    }
}
