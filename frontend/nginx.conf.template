# Single public origin for the whole app.
#
# nginx serves the SPA and forwards the backend's routes to it, so the browser
# only ever talks to one origin: no CORS, and the session cookie keeps working
# exactly as it did when Express served both halves.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Hide the nginx version
    server_tokens off;

    # Docker's embedded DNS. Without a resolver, nginx resolves an upstream
    # hostname ONCE at startup and caches the address forever — so the moment
    # a backend container is redeployed and gets a new IP, every proxied
    # request 502s until nginx itself is restarted. With this, and a variable
    # in proxy_pass to force runtime resolution, a backend can be replaced on
    # its own.
    resolver 127.0.0.11 valid=10s ipv6=off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript
               application/xml image/svg+xml application/manifest+json;

    # --- Security headers (previously set by Express) ---
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.google.com https://www.gstatic.com https://static.cloudflareinsights.com https://pagead2.googlesyndication.com https://adservice.google.com https://fundingchoicesmessages.google.com https://*.adtrafficquality.google https://*.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ${PUBLIC_STORAGE_ORIGIN} https://www.google.com https://www.gstatic.com https://*.gstatic.com https://pagead2.googlesyndication.com https://adservice.google.com https://fundingchoicesmessages.google.com https://ep1.adtrafficquality.google https://*.google-analytics.com https://*.doubleclick.net; frame-src 'self' https://www.google.com https://www.gstatic.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://*.adtrafficquality.google https://*.google.com; frame-ancestors 'none'; object-src 'none'" always;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

