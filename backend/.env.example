# Backend service configuration. Copy to .env and fill in.

NODE_ENV=
PORT=

# --- Local Postgres (docker compose -f docker-compose.dev.yml up -d) ---
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=
DATABASE_URL=

# --- Where the frontend runs: used to fetch index.html for OG tag injection ---
FRONTEND_ORIGIN=
APP_BASE_URL=

# --- CORS: empty because the Vite dev server proxies /api, so it is same-origin ---
CORS_ORIGINS=

SESSION_SECRET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
PUBLIC_OBJECT_SEARCH_PATHS=
VITE_PUBLIC_MINIO_URL=
RECAPTCHA_SECRET_KEY=
RESEND_API_KEY=
CHALLENGERMODE_API_KEY=
CHALLENGERMODE_AUTH_URL=
CHALLENGERMODE_GRAPHQL_URL=
CHALLENGERMODE_REFRESH_KEY=
CHALLONGE_API_KEY=
CHALLONGE_API_REST_URL=
CHALLONGE_APP_CLIENT_ID=
CHALLONGE_APP_CLIENT_SECRET=
CM_CLIENT_ID=
CM_CLIENT_SECRET=

# OAuth redirect for local testing
CM_REDIRECT_URI=
