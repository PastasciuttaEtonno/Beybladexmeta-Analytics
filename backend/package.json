  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "build": "esbuild src/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "db:create": "tsx scripts/db-create.ts",
    "db:test-conn": "tsx scripts/db-test-conn.ts",
    "db:import": "tsx scripts/import-csv.ts",
    "db:migrate:tournaments": "tsx scripts/db-add-tournaments.ts",
    "regional:recalc": "tsx scripts/recalc-regional.ts",
    "players:view": "tsx scripts/player-leaderboard-view.ts",
    "user:create": "tsx src/create-user.ts",
    "migrate:challonge-combos": "tsx scripts/migrate-challonge-combos.ts",
    "debug:challonge-data": "tsx scripts/debug-challonge-data.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.980.0",
    "@aws-sdk/s3-request-presigner": "^3.980.0",
    "@google-cloud/recaptcha-enterprise": "^6.3.1",
    "@napi-rs/canvas": "^0.1.92",
    "@neondatabase/serverless": "^0.10.4",
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.0",
    "express": "^4.22.2",
    "express-session": "^1.18.1",
