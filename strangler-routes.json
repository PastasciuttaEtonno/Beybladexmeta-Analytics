{
  "_comment": [
    "Single source of truth for the Express -> FastAPI migration.",
    "A route listed here is served by FastAPI; everything else still goes to Express.",
    "",
    "After editing: run `npm run strangler:sync` to regenerate the nginx location",
    "blocks, then `npm run strangler:parity` to prove both backends still agree.",
    "The Vite dev server reads this file directly, so it needs no regeneration.",
    "",
    "match: 'exact' -> one URL only; 'prefix' -> that path and everything under it.",
    "samples: extra URLs (with query strings) the parity check should compare.",
    "",
    "Prefer 'exact' so an unmigrated sibling keeps going to Express: /api/stats/combos",
    "is migrated, but /api/stats/combos/:key/tournaments is NOT and must not be caught."
  ],
  "migrated": [
    { "path": "/api/health", "match": "exact" },
    { "path": "/api/components", "match": "exact" },
    { "path": "/api/seasons", "match": "exact" },

    {
      "path": "/api/stats/combos",
      "match": "exact",
      "samples": [
        "/api/stats/combos?limit=5",
        "/api/stats/combos?page=2&limit=7",
        "/api/stats/combos?limit=5&sortBy=first&sortOrder=asc",
        "/api/stats/combos?limit=5&sortBy=fourth",
        "/api/stats/combos?limit=5&sortBy=nonsense&sortOrder=sideways",
        "/api/stats/combos?search=Wizard&limit=5",
        "/api/stats/combos?search=wIzArD&limit=5",
        "/api/stats/combos?season=Off%20Season%202025&limit=5",
        "/api/stats/combos?season=Off%20Season%202025&search=Wizard&limit=5",
        "/api/stats/combos?season=All%20Time&limit=5",
        "/api/stats/combos?limit=9999",
        "/api/stats/combos?page=0&limit=0",
        "/api/stats/combos?page=abc&limit=xyz",
        "/api/stats/combos?search=nothing-matches-this&limit=5"
      ]
    },
    {
      "path": "/api/stats/combos/by-key",
      "match": "exact",
      "samples": [
        "/api/stats/combos/by-key?key=WizardRod%7CNone%7C1-60%7CHexa%7CNone",
        "/api/stats/combos/by-key?key=izardod-1-60-exa",
        "/api/stats/combos/by-key?key=does-not-exist",
        "/api/stats/combos/by-key?key=",
        "/api/stats/combos/by-key?key=A%7CB%7CC"
      ]
    },
    {
      "path": "/api/stats/combos/by-slug",
      "match": "exact",
      "samples": [
        "/api/stats/combos/by-slug?slug=izardod-1-60-exa",
        "/api/stats/combos/by-slug?slug=ilverolf-9-60-reeall",
        "/api/stats/combos/by-slug?slug=does-not-exist",
        "/api/stats/combos/by-slug?slug="
      ]
    },

    {
      "path": "/api/stats/top/components",
      "match": "exact",
      "samples": [
        "/api/stats/top/components?season=Off%20Season%202025",
        "/api/stats/top/components?season=all",
        "/api/stats/top/components?season=All%20Time",
        "/api/stats/top/components?season=Season%202026"
      ]
    },
    { "path": "/api/stats/top/blade", "match": "exact" },
    { "path": "/api/stats/top/ratchet", "match": "exact" },
    { "path": "/api/stats/top/bit", "match": "exact" },

    {
      "path": "/api/stats/leaderboard/blade",
      "match": "exact",
      "samples": [
        "/api/stats/leaderboard/blade?limit=3",
        "/api/stats/leaderboard/blade?limit=999",
        "/api/stats/leaderboard/blade?season=Off%20Season%202025",
        "/api/stats/leaderboard/blade?season=All%20Time"
      ]
    },
    { "path": "/api/stats/leaderboard/ratchet", "match": "exact" },
    {
      "path": "/api/stats/leaderboard/bit",
      "match": "exact",
      "samples": ["/api/stats/leaderboard/bit?season=All%20Time&limit=4"]
    },

    {
      "path": "/api/analytics/meta",
      "match": "exact",
      "samples": [
        "/api/analytics/meta?season=Off%20Season%202025",
        "/api/analytics/meta?season=Season%202026",
        "/api/analytics/meta?platform=challengermode",
        "/api/analytics/meta?platform=challonge",
        "/api/analytics/meta?platform=all&season=all"
      ]
    },
    {
      "path": "/api/trends",
      "match": "exact",
      "samples": [
        "/api/trends?metric=points&granularity=month",
        "/api/trends?metric=points&granularity=week",
        "/api/trends?metric=count&granularity=month",
        "/api/trends?metric=count&granularity=week",
        "/api/trends?metric=points&granularity=month&season=Off%20Season%202025",
        "/api/trends?metric=count&granularity=month&season=Season%202026",
        "/api/trends?metric=bogus&granularity=bogus"
      ]
    },
    {
      "path": "/api/synergy",
      "match": "exact",
      "samples": [
        "/api/synergy?type=blade&name=WizardRod",
        "/api/synergy?type=ratchet&name=1-60",
        "/api/synergy?type=bit&name=Hexa",
        "/api/synergy?type=assist-blade&name=None",
        "/api/synergy?type=lock-chip&name=None",
        "/api/synergy?type=blade",
        "/api/synergy?type=bogus&name=X",
        "/api/synergy"
      ]
    }
  ]
}
