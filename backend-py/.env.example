# FastAPI service configuration.
# DATABASE_URL and SESSION_SECRET must match the Express backend exactly:
# the two services share the database and the session cookie.

DATABASE_URL=
SESSION_SECRET=
PORT=8000

# Leave empty in the single-origin deployment (nginx proxies to this service).
CORS_ORIGINS=

# --- ChallengerMode: must match backend/.env, the two share external_api_cache ---
CHALLENGERMODE_REFRESH_KEY=
CHALLENGERMODE_API_KEY=
CHALLENGERMODE_AUTH_URL=
CHALLENGERMODE_GRAPHQL_URL=
# Set very high locally so parity checks never hit the live API.
CHALLENGERMODE_CACHE_TTL_MINUTES=
CM_CLIENT_ID=
CM_CLIENT_SECRET=
RECAPTCHA_SECRET_KEY=
RESEND_API_KEY=
APP_BASE_URL=
