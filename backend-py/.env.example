# FastAPI service configuration.
# DATABASE_URL and SESSION_SECRET must match the Express backend exactly:
# the two services share the database and the session cookie.

DATABASE_URL=
SESSION_SECRET=
PORT=8000

# Leave empty in the single-origin deployment (nginx proxies to this service).
CORS_ORIGINS=

# --- ChallengerMode: must match backend/.env, the two share external_api_cache ---
CHALLENGERMODE_REFRESH_KEY=
CHALLENGERMODE_API_KEY=
CHALLENGERMODE_AUTH_URL=
CHALLENGERMODE_GRAPHQL_URL=
# Set very high locally so parity checks never hit the live API.
CHALLENGERMODE_CACHE_TTL_MINUTES=
CM_CLIENT_ID=
CM_CLIENT_SECRET=
RECAPTCHA_SECRET_KEY=
RESEND_API_KEY=
APP_BASE_URL=
FRONTEND_ORIGIN=
VITE_PUBLIC_MINIO_URL=

# --- Challonge ---
# Only /api/admin/sync-challonge uses this; the real Challonge dataset was
# scraped and loaded by hand, so it is normally unset.
CHALLONGE_API_KEY=
# The Challonge OAuth application, distinct from the key above.
CHALLONGE_APP_CLIENT_ID=
CHALLONGE_APP_CLIENT_SECRET=

# --- ChallengerMode, optional overrides ---
# Where the OAuth flow reads the linked profile from. Has a built-in default.
CM_USERINFO_URL=
# Where the service access token is cached. Defaults to the system temp dir.
CHALLENGERMODE_TOKEN_CACHE_PATH=

# --- Object storage ---
# Not read by the application: tools/convert-images-to-webp.py uses these to
# reach Garage. The browser reaches it through VITE_PUBLIC_MINIO_URL instead.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- RAG / Voyage AI -------------------------------------------------------
# Chiave per embedding e re-ranking. L'account ha 200 milioni di token gratuiti
# per gli embedding e altri 200 per il rerank: il corpus intero ne vale 81.000,
# quindi il costo non e' il vincolo. Il vincolo e' il rate limit.
VOYAGE_API_KEY=

# I default nel codice sono tarati per il Tier 1, che si ottiene registrando un
# metodo di pagamento (non serve spendere: sblocca 8M token/minuto e i 200
# milioni gratuiti restano). Reindicizzazione completa: ~12 secondi.
#
# SENZA metodo di pagamento la chiave resta a ~3.000 token/minuto e voyage-4
# risponde 429. Togli il commento a questo blocco: la reindicizzazione passa a
# ~30 minuti ma funziona.
#
# VOYAGE_MODEL=voyage-4-lite
# VOYAGE_BATCH=16
# VOYAGE_PAUSE=60
# VOYAGE_RERANK_MODEL=rerank-2.5-lite
# VOYAGE_RERANK_WINDOW=8
# VOYAGE_RERANK_CHARS=1200
